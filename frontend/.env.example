# ---- Hoodpoker frontend environment ----
# Copy to .env.local and fill in.

# Reown (WalletConnect) Cloud project ID — https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=43bdd1b8c477ac4d4a4264a14a8472f8

# Alchemy API key — mainnet reads only (ENS primary names for players who
# have one). hoodfi.eth handles are read from Robinhood Chain, not from here.
# https://dashboard.alchemy.com
NEXT_PUBLIC_ALCHEMY_KEY=your-alchemy-key

# Robinhood Chain RPC (chain 4663). Optional — defaults to the public
# endpoint. Set this to a paid endpoint if handle lookups start getting
# throttled.
NEXT_PUBLIC_ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# Deployed Cloudflare Worker origin (no trailing slash)
NEXT_PUBLIC_WORKER_URL=https://epoker-worker.your-subdomain.workers.dev

# Pinata JWT — only read by `node pin.mjs`, never bundled into the app.
PINATA_JWT=
