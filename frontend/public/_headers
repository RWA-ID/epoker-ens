# Read by Cloudflare static assets only (IPFS ignores it). On eth.limo the
# gateway sent these; at hoodpoker.fun nobody does unless this file does.
# frame-ancestors is what Privy's clickjacking guidance asks for — it can't
# live in the <meta> CSP that scripts/inject-csp.mjs writes.
/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Hashed build chunks never change under the same name.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
